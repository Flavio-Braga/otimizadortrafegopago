# Chave da API do Groq. Obtenha (gratuitamente) em https://console.groq.com/keys
# Copie este arquivo para .env.local e preencha com a sua chave real.
GROQ_API_KEY=your_groq_api_key_here

# (Opcional) Modelo do Groq a ser usado. Padrão: llama-3.3-70b-versatile
# Lista de modelos: https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
